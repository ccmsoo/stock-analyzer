<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  설치:
    1) 시스템 환경설정 → 일반 → 시간대 가 'KST(Asia/Seoul)' 인지 확인
    2) cp scripts/com.stockanalyzer.daily.plist ~/Library/LaunchAgents/
    3) launchctl load ~/Library/LaunchAgents/com.stockanalyzer.daily.plist
    4) 검증: launchctl list | grep stockanalyzer
    수정/제거:
    launchctl unload ~/Library/LaunchAgents/com.stockanalyzer.daily.plist
    rm ~/Library/LaunchAgents/com.stockanalyzer.daily.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockanalyzer.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/choiminsoo/Downloads/stock_analyzer/scripts/daily_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/choiminsoo/Downloads/stock_analyzer</string>

    <!-- 평일 15:30 KST 실행 (Mon=1 ~ Fri=5)
         macOS는 시스템 시간대 기준이므로 시스템이 KST면 그대로 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- 스케줄 시점에 Mac이 꺼져있거나 잠들었다면 깨어난 직후 한 번 실행 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/choiminsoo/Downloads/stock_analyzer/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/choiminsoo/Downloads/stock_analyzer/logs/launchd.err.log</string>

    <!-- PATH 같은 기본 환경변수가 비어있으면 안 되니 최소만 설정 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
